// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum JobStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
}

enum JobSource {
  JOB_BOARD
  COMPANY_WEBSITE
  REFERRAL
  RECRUITER
  SOCIAL
  EVENT
  OTHER
}

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  ONSITE
  HR
  FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
}

enum JobActivityType {
  STATUS_CHANGE
  NOTE
  INTERVIEW
  COMMUNICATION
  REMINDER
  CUSTOM
}

enum NotificationType {
  NEXT_ACTION_REMINDER
  NEXT_ACTION_OVERDUE
  INTERVIEW_REMINDER
  INTERVIEW_FOLLOW_UP
  APPLICATION_STALE
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationEntityType {
  JOB
  INTERVIEW
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String?
  role                UserRole  @default(USER)
  refreshTokenVersion Int       @default(0)
  emailVerified       Boolean   @default(false)
  emailVerifiedAt     DateTime?
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?

  jobs                    Job[]
  interviews              Interview[]
  notes                   Note[]
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  companyReviews          CompanyReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model Company {
  id          String       @id @default(uuid())
  name        String       @unique
  website     String?
  description String?
  industry    String?
  size        CompanySize?
  location    String?
  logoUrl     String?

  jobs    Job[]
  reviews CompanyReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyReview {
  id            String  @id @default(uuid())
  rating        Int?
  processRating Int?
  review        String?

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model Job {
  id             String          @id @default(uuid())
  title          String
  description    String?
  status         JobStatus       @default(SAVED)
  priority       JobPriority     @default(MEDIUM)
  source         JobSource?
  location       String?
  remoteType     RemoteType?
  employmentType EmploymentType?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  url            String?

  appliedAt      DateTime?
  nextActionDate DateTime?
  closedAt       DateTime?
  archivedAt     DateTime?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  interviews Interview[]
  notes      Note[]
  activities JobActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([userId, status])
  @@index([nextActionDate])
  @@index([userId, nextActionDate])
}

model Interview {
  id              String          @id @default(uuid())
  type            InterviewType
  status          InterviewStatus @default(SCHEDULED)
  result          InterviewResult @default(PENDING)
  scheduledAt     DateTime
  completedAt     DateTime?
  durationMinutes Int?
  remoteType      RemoteType?
  location        String?
  interviewers    String[]        @default([])
  prepNotes       String?
  feedback        String?
  rating          Int?
  difficulty      Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([jobId])
  @@index([scheduledAt])
  @@index([jobId, status])
}

model Note {
  id      String @id @default(uuid())
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([userId])
}

model JobActivity {
  id          String          @id @default(uuid())
  type        JobActivityType
  description String
  fromStatus  JobStatus?
  toStatus    JobStatus?
  metadata    Json?

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@index([jobId, type])
}

model Notification {
  id       String               @id @default(uuid())
  type     NotificationType
  priority NotificationPriority @default(NORMAL)
  title    String
  message  String
  actionUrl String?
  read     Boolean              @default(false)
  readAt   DateTime?

  relatedEntityType NotificationEntityType?
  relatedEntityId   String?
  metadata          Json?

  scheduledAt DateTime?
  expiresAt   DateTime?

  // Deterministic, source-date-derived key that makes notification creation
  // idempotent across worker retries and manual queue recreation. Nullable so
  // ad-hoc notifications (e.g. SYSTEM) are not forced to share the mechanism;
  // Postgres allows multiple NULLs under a unique index.
  dedupeKey String? @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([scheduledAt])
  @@index([relatedEntityType, relatedEntityId])
}

model NotificationPreferences {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  inAppEnabled                     Boolean @default(true)
  nextActionRemindersEnabled       Boolean @default(true)
  interviewRemindersEnabled        Boolean @default(true)
  interviewFollowUpsEnabled        Boolean @default(true)
  staleApplicationRemindersEnabled Boolean @default(true)

  // IANA timezone (validated server-side). UTC fallback.
  timezone String @default("UTC")

  // Configurable offsets, persisted in minutes/days and validated server-side.
  nextActionReminderLeadMinutes Int   @default(1440)
  interviewReminderLeadMinutes  Int[] @default([1440, 120])
  interviewFollowUpDelayMinutes Int   @default(1440)
  staleApplicationThresholdDays Int   @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
